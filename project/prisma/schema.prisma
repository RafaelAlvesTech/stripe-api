// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// file: prisma/schema.prisma

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  stripeCustomerId String?

  // --- CAMPOS NOVOS E NECESSÁRIOS ---
  cpf_cnpj         String?   @unique // NOVO! Para armazenar o CPF ou CNPJ.
  phone            String?   // NOVO! Telefone do usuário.
  street           String?   // NOVO! Rua, número e complemento.
  city             String?   // NOVO! Cidade.
  state            String?   // NOVO! Sigla do estado (ex: BA, SP).
  postal_code      String?   // NOVO! CEP.

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions Transaction[]
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("BRL")
  status          TransactionStatus @default(PENDING)
  stripePaymentId String?           @unique // Mudei para @unique, é uma boa prática.
  description     String?
  createdAt       DateTime          @default(now())

  // --- MELHORIAS OPCIONAIS PARA UX ---
  boletoUrl       String?           // NOVO! Para salvar o link do PDF do boleto.
  boletoLine      String?           // NOVO! Para salvar a linha digitável.

  user User @relation(fields: [userId], references: [id])
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}
